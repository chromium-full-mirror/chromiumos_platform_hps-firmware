# found in the LICENSE file.

set -e

PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")"/..)

cd "${PROJECT_ROOT}/mcu_rom/stage1_app"
cargo build --no-default-features --features proto2,standalone,dev,image-transfer "$@"
BINARY="target/thumbv6m-none-eabi/debug/stage1_app"
openocd -f "${PROJECT_ROOT}/toolchain/mcu_dev/proto2.openocd.cfg" -c "gdb_port 3333" -c "telnet_port 4444" -c "tcl_port 6666" --search tcl -c "program $BINARY verify reset"
