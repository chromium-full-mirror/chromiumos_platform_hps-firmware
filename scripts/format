#!/bin/bash

# Runs autoformatters on our source files.

PROJECT_ROOT=$(realpath $(dirname ${BASH_SOURCE[0]})/..)

# Format Python code.
autopep8 -i "${PROJECT_ROOT}/soc"/*.py

# Format C code. We use an absoute path to avoid using the the depot_tools
# binary, if that's on our path, since it doesn't work.
/usr/bin/clang-format -i --style=Google "${PROJECT_ROOT}/soc_rom"/*.{c,h}
