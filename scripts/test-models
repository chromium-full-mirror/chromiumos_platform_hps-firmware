# Builds FPGA ROM, uploads to device, uploads test images, then runs model on
# all test images.

set -e

PROJECT_ROOT=$(git rev-parse --show-toplevel)

"${PROJECT_ROOT}/scripts/fpga-rom-run" \
    --cmd 'reset_mcu; write_test_images; launch_app_without_i2c; fpga_self_test' \
    "$@"
