#!/usr/bin/env python3
from pyftdi.ftdi import Ftdi
from pyftdi.gpio import GpioAsyncController

Ftdi.show_devices()
gpio = GpioAsyncController()
# Set GPIO pins 4 (firmware write protect), 5 (i2c level shifter enable) and 6
# (hps power enable) as outputs.
gpio.configure('ftdi://ftdi:ft4232/1', direction=0x10 | 0x20 | 0x40)
# Set i2c level shifter high (active) and the other two pins low. Power enable
# is active-low (although this was an accident, so will change with proto2).
gpio.write(0x20)
