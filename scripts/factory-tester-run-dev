# Runs the factory tester MCU code directly on proto2. Doesn't require factory
# tester hardware.

set -e

PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")"/..)

cd "${PROJECT_ROOT}/rust/mcu"
cargo build -p factory_tester_mcu --features dev
BINARY="target/thumbv6m-none-eabi/debug/factory_tester_mcu"
openocd -f "${PROJECT_ROOT}/toolchain/mcu_dev/proto2.openocd.cfg" --search tcl -c "program $BINARY verify reset"
