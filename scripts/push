#!/bin/bash
# Pushes a change to Gerrit for review

RED='\033[0;31m'
NO_COLOR='\033[0m'

set -e

PROJECT_ROOT=$(realpath $(dirname ${BASH_SOURCE[0]})/..)

$PROJECT_ROOT/scripts/check-formatting

git fetch origin
if [ $(git log HEAD..origin/main | wc -l) -ne 0 ]; then
  echo -e "${RED}Please rebase your changes first. origin/main has extra commits.${NO_COLOR}" >&2
  exit 1
fi
git push $(git remote get-url origin) HEAD:refs/for/main

