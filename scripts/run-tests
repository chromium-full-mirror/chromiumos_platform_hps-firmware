# Runs tests that can be run without hardware.

RED='\033[0;31m'
GREEN='\033[0;32m'
NORMAL='\033[0m'

set -e
PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")"/..)

source "${PROJECT_ROOT}/environment"

# Crates that can be tested without hardware.

cd "${PROJECT_ROOT}/rust"
cargo +stable test

cargo +"${RUST_NIGHTLY_VERSION}" miri test

# Harware-specific crates. Just build these.

cd "${PROJECT_ROOT}/rust/stage0"
cargo +stable build

cd "${PROJECT_ROOT}/rust/stage1_app"
cargo +stable build
for board in nucleo proto2; do
    echo "===== Building application for board $board ====="
    cargo +stable build --no-default-features --features $board
done

cd "${PROJECT_ROOT}/rust/factory_tester_mcu"
echo "===== Release build of factory_tester_mcu ====="
cargo +stable build --no-default-features --release
echo "===== Dev build of factory_tester_mcu ====="
cargo +stable build --no-default-features --features dev
echo "===== Stage1 build of factory_tester_mcu ====="
cargo +stable build --no-default-features --features stage1

echo "===== factory_tester ====="
cd "${PROJECT_ROOT}/rust/factory_tester"
cargo +stable build

cd "${PROJECT_ROOT}/rust/stm32g0_i2c_peripheral"
cargo +stable build

echo "===== RISCV ====="
cd "${PROJECT_ROOT}/rust/riscv"
cargo +stable build

echo "===== RISCV with image transfer ====="
cd "${PROJECT_ROOT}/rust/riscv"
cargo +stable build --features image-transfer

# Run Python tests
cd "${PROJECT_ROOT}"
echo -e "\n\n${RED}=======================================${NORMAL}"
echo -e "${GREEN}Running Python tests from soc directory${NORMAL}"
echo -e "${RED}=======================================${NORMAL}"
scripts/pyrun -m unittest soc/*.py
