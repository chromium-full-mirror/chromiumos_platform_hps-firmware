# Runs tests that can be run without hardware.

RED='\033[0;31m'
GREEN='\033[0;32m'
NORMAL='\033[0m'

set -e
PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")"/..)

# Crates that can be tested without hardware.

cd "${PROJECT_ROOT}/mcu_rom"
cargo +stable test

# Harware-specific crates. Just build these.

cd "${PROJECT_ROOT}/mcu_rom/stage0"
cargo +stable build

cd "${PROJECT_ROOT}/mcu_rom/stage1"
cargo +stable build

cd "${PROJECT_ROOT}/mcu_rom/stm32g0_application"
cargo +stable build
for board in proto1 nucleo proto2; do
    echo "===== Building application for board $board ====="
    cargo +stable build --no-default-features --features $board
done

cd "${PROJECT_ROOT}/mcu_rom/factory_tester_mcu"
cargo +stable build --no-default-features
cargo +stable build --no-default-features --features dev

cd "${PROJECT_ROOT}/mcu_rom/stm32g0_i2c_peripheral"
cargo +stable build

# Run Python tests
cd "${PROJECT_ROOT}"
echo -e "\n\n${RED}=======================================${NORMAL}"
echo -e "${GREEN}Running Python tests from soc directory${NORMAL}"
echo -e "${RED}=======================================${NORMAL}"
scripts/pyrun -m unittest soc/*.py
