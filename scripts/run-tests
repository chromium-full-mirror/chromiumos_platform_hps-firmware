# Runs tests that can be run without hardware.

RED='\033[0;31m'
GREEN='\033[0;32m'
NORMAL='\033[0m'

set -e
PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")"/..)

source "${PROJECT_ROOT}/environment"

# Crates that can be tested without hardware.

cd "${PROJECT_ROOT}/rust"
cargo test

# Harware-specific crates. Just build these.

cd "${PROJECT_ROOT}/rust/mcu"
# We do a release build of MCU firmware, since stage0 doesn't support
# non-release builds due to size constraints.
cargo build --release

echo "===== Release build of factory_tester_mcu ====="
cargo build -p factory_tester_mcu --no-default-features --release
echo "===== Dev build of factory_tester_mcu ====="
cargo build -p factory_tester_mcu --no-default-features --features dev
echo "===== Stage1 build of factory_tester_mcu ====="
cargo build -p factory_tester_mcu --no-default-features --features stage1

echo "===== RISCV default ====="
cd "${PROJECT_ROOT}/rust/riscv"
cargo build

echo "===== RISCV with all features ====="
cd "${PROJECT_ROOT}/rust/riscv"
cargo build --all-features

# Run Python tests
cd "${PROJECT_ROOT}"
echo -e "\n\n${RED}=======================================${NORMAL}"
echo -e "${GREEN}Running Python tests from soc directory${NORMAL}"
echo -e "${RED}=======================================${NORMAL}"
scripts/pyrun -m unittest soc/*.py
