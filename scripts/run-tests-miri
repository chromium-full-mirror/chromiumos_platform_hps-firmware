# Runs rust tests with MIRI. This can detect many kinds of undefined behavior,
# but is really slow, so is kept separate from scripts/run-tests. It should be
# run manually if you're making changes to unsafe code.

set -e
PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")"/..)

source "${PROJECT_ROOT}/environment"


cd "${PROJECT_ROOT}/rust"

# exclude TERM for a modest speedup, as per:
# https://github.com/rust-lang/miri/issues/1702
export MIRIFLAGS="-Zmiri-disable-isolation -Zmiri-env-exclude=TERM"

# We exclude hps-factory from miri tests because its build.rs builds lots of
# other crates that are time-consuming to build.
cargo \
    +"${RUST_NIGHTLY_VERSION}" \
    miri test \
    --exclude hps-factory \
    --workspace \
    -- \
    --skip nomiri
