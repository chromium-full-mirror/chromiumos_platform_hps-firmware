#!/bin/bash

# Copyright 2021 The Chromium OS Authors. All rights reserved.
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")"/..)
source "${PROJECT_ROOT}/environment"

set -e
git submodule update --init --recursive

# Verify dependencies that can be installed with apt (if available)
missing=()

if ! which arm-none-eabi-gcc >/dev/null; then
    missing+=(gcc-arm-none-eabi)
fi

if ! which gdb-multiarch >/dev/null; then
    missing+=(gdb-multiarch)
fi

if ! which ccache >/dev/null; then
    missing+=(ccache)
fi

if ! which clang++ >/dev/null; then
    missing+=(clang)
fi

if ! which autopep8 >/dev/null; then
    missing+=(python3-autopep8)
fi

if [ ! -f /usr/bin/clang-format ]; then
    missing+=(clang-format)
fi

if [ ! -d /usr/include/json-c ]; then
    missing+=(libjson-c-dev)
fi

if [ ! -d /usr/include/event2 ]; then
    missing+=(libevent-dev)
fi

if ! which ninja >/dev/null; then
    missing+=(ninja-build)
fi

if ! which openocd >/dev/null; then
    missing+=(openocd)
fi

if ! which st-util >/dev/null; then
    missing+=(stlink-tools)
fi

if ! which pygmentize >/dev/null; then
    missing+=(python3-pygments)
fi

if ! python3 -c 'import serial' 2> /dev/null; then
    missing+=(python3-serial)
fi

if ! python3 -c 'import pylint' 2> /dev/null; then
    missing+=(pylint)
fi

if ! which lld >/dev/null; then
    missing+=(lld)
fi

if ! command -v llvm-objcopy-13 >/dev/null ; then
    missing+=(llvm-13)
fi

if [ ! -f /usr/include/libusb-1.0/libusb.h ]; then
    missing+=(libusb-1.0-0-dev)
fi

if [ ! -f /usr/include/libftdi1/ftdi.h ]; then
    missing+=(libftdi1-dev)
fi

if [ ! -f /usr/include/dbus-1.0/dbus/dbus-glib.h ]; then
    missing+=(libdbus-glib-1-dev)
fi

if [ ! -f /usr/include/libudev.h ]; then
    missing+=(libudev-dev)
fi

if [ ! -f /usr/include/readline/readline.h ]; then
    missing+=(libreadline-dev)
fi

# The following dependencies are for building the FPGA tools below,
# not for HPS itself:
if [ ! -f /usr/include/tcl/tcl.h ]; then
    missing+=(tcl-dev)
fi
if ! command -v bison >/dev/null; then
    missing+=(bison)
fi
if ! command -v flex >/dev/null; then
    missing+=(flex)
fi
if ! command -v cmake >/dev/null; then
    missing+=(cmake)
fi
if [ ! -f /usr/include/boost/version.hpp ]; then
    missing+=(libboost-all-dev)
fi
if [ ! -f /usr/include/eigen3/Eigen/Core ]; then
    missing+=(libeigen3-dev)
fi

if [ ${#missing[@]} -gt 0 ]; then
    echo "Missing packages: ${missing[*]}" >&2
    if which apt >/dev/null; then
        echo -n "Install [y]/n? " >&2
        read -r answer
        if [ "${answer}" == "y" ] || [ -z "${answer}" ]; then
            sudo apt install -y "${missing[@]}"
        fi
    else
        exit 1
    fi
fi

# Ensure specific RISCV compiler installed
if ! riscv64-unknown-elf-gcc --version 2>/dev/null | grep 10.1.0 >/dev/null; then
    echo "riscv64-unknown-elf-gcc is missing or out-of-date" >&2
    echo -n "Download and install 290MB [y]/n? " >&2
    read -r answer
    if [ "${answer}" == "y" ] || [ -z "${answer}" ]; then
        (
            PKG_URL=https://static.dev.sifive.com/dev-tools/freedom-tools/v2020.08/riscv64-unknown-elf-gcc-10.1.0-2020.08.2-x86_64-linux-ubuntu14.tar.gz
            mkdir -p ~/Downloads
            mkdir -p "${PROJECT_ROOT}/third_party/installed"
            curl "${PKG_URL}" -o ~/Downloads/riscv64.tar.gz
            tar -C "${PROJECT_ROOT}/third_party/installed" \
                --strip-components=1 -xvz -f ~/Downloads/riscv64.tar.gz
        )
    fi
fi

if ! which rustup >/dev/null; then
    echo -n "Install Rust [y]/n?" >&2
    read -r answer
    if [ "${answer}" == "y" ] || [ -z "${answer}" ]; then
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
        if ! which rustup >/dev/null; then
            echo "restart your shell and then re-run this script"
            exit 1
        fi
    fi
fi

rustup toolchain install "${RUST_VERSION}" --profile default
rustup toolchain install "${RUST_NIGHTLY_VERSION}" --profile default

rustup "+${RUST_VERSION}" target add thumbv6m-none-eabi
rustup "+${RUST_VERSION}" target add thumbv7em-none-eabihf
rustup "+${RUST_VERSION}" target add x86_64-unknown-linux-musl
rustup "+${RUST_VERSION}" target add riscv32i-unknown-none-elf
(cd "${PROJECT_ROOT}" && rustup override set "${RUST_VERSION}")

rustup component add miri --toolchain "${RUST_NIGHTLY_VERSION}"
cargo +"${RUST_NIGHTLY_VERSION}" miri setup

rustup component add llvm-tools-preview

for i in flip-link; do
    if [ ! -f "${HOME}/.cargo/bin/${i}" ]; then
        cargo install "${i}"
    fi
done

if ! which svd2rust; then
    cargo install svd2rust
fi

MCP_UDEV_RULES=/etc/udev/rules.d/71-mcp.rules
if [ ! -f "${MCP_UDEV_RULES}" ]; then
    echo -n "OK to create ${MCP_UDEV_RULES} [y]/n? " >&2
    read -r answer
    if [ "${answer}" == "y" ] || [ -z "${answer}" ]; then
        (
            cat <<'EOF'
# MCP2221A rules
SUBSYSTEM=="usb", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="00dd", GROUP="plugdev", TAG+="uaccess", RUN="/bin/sh -c 'echo -n $kernel > /sys/bus/usb/drivers/usbhid/unbind'"
EOF
        ) | sudo tee "${MCP_UDEV_RULES}"
    fi
fi

# Warn about different versions
if ! arm-none-eabi-gcc --version | grep ' 8.3.' >/dev/null; then
    echo "Possibly unsupported version of arm-none-eabi-gcc. 8.3.1 works." >&2
fi

# Build gn if it hasn't already been built
GN="${PROJECT_ROOT}/third_party/gn"
if [ ! -f "${GN}/out/gn" ]; then
    cd "${GN}" || exit
    python3 build/gen.py
    ninja -C out
fi

# Build yosys
echo "BUILDING YOSYS"
(
    cd "${PROJECT_ROOT}/third_party/yosys"
    make -j
    make DESTDIR="${PROJECT_ROOT}/third_party/installed" PREFIX="" install
)

# Build prjoxide
echo "BUILDING PRJOXIDE"
(
    cd "${PROJECT_ROOT}/third_party/prjoxide/libprjoxide"
    cargo install --path prjoxide --root "${PROJECT_ROOT}/third_party/installed"
)

# Build nextpnr
echo "BUILDING NEXTPNR-NEXUS"
(
    cd "${PROJECT_ROOT}/third_party/nextpnr"
    mkdir -p build
    cd build
    if [ ! -f Makefile ] ; then
        cmake \
            -DARCH=nexus \
            -DOXIDE_INSTALL_PREFIX="${PROJECT_ROOT}/third_party/installed" \
            -DCMAKE_INSTALL_PREFIX="${PROJECT_ROOT}/third_party/installed" \
            ..
    fi
    make -j
    make install
)
