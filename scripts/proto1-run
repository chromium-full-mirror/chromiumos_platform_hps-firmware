set -e

PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")"/..)

"${PROJECT_ROOT}/scripts/proto1-power-on"
cd "${PROJECT_ROOT}/mcu_rom/stm32g0_application"
cargo build --no-default-features --features proto1,defmt-default
BINARY="target/thumbv6m-none-eabi/debug/stm32g0_application"
openocd -f "${PROJECT_ROOT}/toolchain/mcu_dev/proto1.openocd.cfg" --search tcl -c "program $BINARY verify reset"
