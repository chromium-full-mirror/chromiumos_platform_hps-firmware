# Build file for HPS host utilities

executable("hps") {
  sources = [
    "main.cpp",
    "cmd.cpp",
    "status.cpp",
  ]

  include_dirs = [ "//third_party/ftd2xx" ]

  deps = [
    "//host/lib:hpslib",
    "//third_party/ftd2xx:ftd2xx"
  ]

  libs = [
    "//third_party/ftd2xx/libftd2xx.a",
  ]
}
