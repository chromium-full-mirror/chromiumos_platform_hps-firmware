# Build file for HPS host library.

static_library("hpslib") {
  sources = [
    "ftdi.h",
    "ftdi.cpp",
    "hps.cpp",
    "hps.h",
    "i2c.cpp",
    "i2c.h",
  ]

  deps = [
    ":dev",
    "//third_party/ftd2xx:ftd2xx",
  ]
}

static_library("fakedev") {
  sources = [
    "fake_dev.h",
    "fake_dev.cpp",
  ]

  deps = [
    ":dev",
  ]
}

source_set("dev") {
  sources = [
    "dev.h",
    "hps_reg.h",
  ]
}
