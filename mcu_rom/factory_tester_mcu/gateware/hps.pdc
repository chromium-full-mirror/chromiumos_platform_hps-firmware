ldc_set_location -site {A4} [ get_ports {gsrn} ]
ldc_set_location -site {H2} [ get_ports {copi} ]
ldc_set_location -site {F2} [ get_ports {cs} ]
ldc_set_location -site {G8} [ get_ports {data[0]} ]
ldc_set_location -site {F7} [ get_ports {data[1]} ]
ldc_set_location -site {F8} [ get_ports {data[2]} ]
ldc_set_location -site {E7} [ get_ports {data[3]} ]
ldc_set_location -site {E8} [ get_ports {data[4]} ]
ldc_set_location -site {G9} [ get_ports {data[5]} ]
ldc_set_location -site {F9} [ get_ports {data[6]} ]
ldc_set_location -site {E9} [ get_ports {data[7]} ]
ldc_set_location -site {F6} [ get_ports {fvld} ]
ldc_set_location -site {G2} [ get_ports {heartbeat} ]
ldc_set_location -site {G5} [ get_ports {lvld} ]
ldc_set_location -site {F3} [ get_ports {lvld_out} ]
ldc_set_location -site {G7} [ get_ports {pclk} ]
ldc_set_location -site {H1} [ get_ports {sclk} ]
ldc_set_location -site {G3} [ get_ports {led} ]

ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports {gsrn}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {data[0]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {data[1]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {data[2]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {data[3]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {data[4]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {data[5]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {data[6]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {data[7]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {fvld}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {heartbeat}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {lvld}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {lvld_out}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {pclk}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {sclk}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports {led}]
