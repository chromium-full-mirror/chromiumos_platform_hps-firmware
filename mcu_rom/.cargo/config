[target.'cfg(all(target_arch = "arm", target_os = "none"))']
# make `cargo run` start a GDB session
runner = 'gdb-multiarch -q -x ../toolchain/mcu_dev/stm32g03_proto.gdb'

rustflags = [
  # !!CAREFUL!! link.x is an internally generated linker script
  # that will include 'memory.x' in the src root. Changing this
  # will result in mysteriously broken binaries and you will be sad.
  "-C", "link-arg=-Tlink.x",
  # An additional linker script for any HPS-specific linker directives.
  "-C", "link-arg=-T../hps-common-link.x",
  # Linker optimizations that help binary size, especially when mixing C and Rust.
  "-C", "linker-plugin-lto",
  "-C", "linker=clang",
  "-C", "link-arg=-fuse-ld=lld",
  "-C", "link-arg=--target=thumbv6m-none-eabi",
]

[build]
target = "thumbv6m-none-eabi" # Cortex-M0 and Cortex-M0+
