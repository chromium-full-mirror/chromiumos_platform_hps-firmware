group("mcu_rom") {
  deps = [
    ":mcu.bin(//toolchain:arm-none-eabi-gcc)"
  ]
}

arm_shared_flags = [
  "-mcpu=cortex-m0plus",
  "-mthumb",
  "-static",
  "-msoft-float",
  "-fno-common",
  "-ffunction-sections",
  "-fdata-sections",
  "-fomit-frame-pointer",
  "-Os",
  "-g3",
]

config("arm_rom") {
  cflags = arm_shared_flags + [
             "-std=c11",
             "-fno-builtin",
           ]
  include_dirs = [
  ]
  ldflags = arm_shared_flags + [
              "-nostdlib",
              "-nodefaultlibs",
              "-nostartfiles",
              "-Wl,--gc-sections",
              "-Wl,--no-warn-mismatch",
              "-Wl,--build-id=none",
            ]
  libs = [
  ]
}

executable("mcu.bin") {
  sources = [
    "crt.s",
    "entry.c",
  ]
  configs += [ ":arm_rom" ]
}
