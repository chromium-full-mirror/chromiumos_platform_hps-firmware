group("tflm") {
  deps = [
    ":tflite-micro"
  ]
}

riscv_shared_flags = [
  "-march=rv32im",
  "-mabi=ilp32",
  "-ffunction-sections",
  "-fdata-sections",
  "-fno-common",
  "-fomit-frame-pointer",
  "-O2",
]

config("tflm-config") {
  cflags = riscv_shared_flags + [
             "-fno-builtin",
             "-Werror",
             "-Wdouble-promotion",
             "-Wmissing-field-initializers",
             "-Wshadow",
             "-Wsign-compare",
             "-Wswitch",
             "-Wunused-function",
             "-Wno-unused-parameter",
             "-Wunused-variable",
             "-Wvla",
           ]
  cflags_c = [
    "-std=gnu11",
  ]
  cflags_cc = [
    "-std=c++11",
    "-fstrict-aliasing",
    "-fno-rtti",
    "-fno-exceptions",
    "-fno-threadsafe-statics",
    "-fmessage-length=0",
    "-Wall",
    "-Wextra",
    "-Wstrict-aliasing",
    "-Wno-unused-parameter",
  ]
  defines = [
    "NDEBUG",
    "__vexriscv__",
    "GATEWARE_GEN=2",
    "ACCEL_CONV",
    "ACCEL_PAD",
    "ACCEL_MAX_POOL",
    "ACCEL_FULLY_CONNECTED",
    "ACCEL_STRIDED_SLICE",
    "TF_LITE_STATIC_MEMORY",
    "TF_LITE_USE_GLOBAL_CMATH_FUNCTIONS",
    "TF_LITE_USE_GLOBAL_MIN",
    "TF_LITE_USE_GLOBAL_MAX ",
    "TF_LITE_DISABLE_X86_NEON",
  ]
  include_dirs = [
    ".",
    "models",
    "capi",
    "hps_accel", # Must be before tflite-micro
    "tflite-micro",
    "tflite-micro/third_party/gemmlowp",
    "tflite-micro/third_party/flatbuffers/include",
    "tflite-micro/third_party/ruy",
  ]

}

